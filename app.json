{
  "expo": {
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-router"
    ],
    "name": "AppDiario",
    "slug": "AppDiario",
    "scheme": "com.appdiario.app",
    "owner": "innovation369",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appdiario.app"
    },
    "android": {
      "package": "com.appdiario.app",
      "googleServicesFile": "./google-services.json" ,
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.png",
        "backgroundColor": "#ffffff"
      },
      "statusBar": {
        "translucent": true,
        "backgroundColor": "#00000000"
      },
      "navigationBar": {
        "backgroundColor": "#00000000",
        "barStyle": "dark-content",
        "visible": "sticky-immersive"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a5379997-7c54-48c6-a5ff-3a63da45bd21"
      }
    }
  }
}
